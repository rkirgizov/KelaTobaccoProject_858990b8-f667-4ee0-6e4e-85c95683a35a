function KTPHasTobaccoStatus(entity)
    local entity = entity or context.Target
    local result = Tagged('KTP_TOBACCO_FILLED', entity)
    return ConditionResult(result.Result, {ConditionError("KTPHasNotTobaccoStatus")})
end

function KTPPlayerHasNotMaxOverdoseStatus(entity)
    local entity = entity or context.Source
    local result = ~HasStatus('KTP_OVERDOSE_5', entity)
    return ConditionResult(result.Result, {ConditionError("KTPPlayerHasMaxOverdoseStatus")})
end

function CanUseDebug()
    local result = true
    return ConditionResult(result)
end
